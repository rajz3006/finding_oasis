# Supabase Postgres. Runtime uses the pooled (pgbouncer) connection; migrations use the direct one.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Local dev alternative: both point at a local Postgres, e.g. postgresql://postgres@localhost:5432/eb1a

# Supabase API. One URL for server and browser (NEXT_PUBLIC_ values are public by design; the anon key is safe to expose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server only (storage + bucket setup). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for evidence files (private)
SUPABASE_EVIDENCE_BUCKET=evidence
# Single allowed login email (single-user app)
ALLOWED_EMAIL=
# SECRET: shared secret the Vercel cron request must present (Authorization: Bearer ...)
CRON_SECRET=
# Optional: DB-backed seed test (src/lib/seed.test.ts). Must be an empty throwaway database.
TEST_DATABASE_URL=
# Optional: PatentsView connector (https://patentsview.org/apis) and Semantic Scholar rate limits
PATENTSVIEW_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Optional: GitHub token (higher rate limits; enables contribution counts in GitHub Profile)
GITHUB_TOKEN=
# Optional: self-hosted Plausible/Umami (or set baseUrl/siteId/token in the "Site Analytics" Source config;
# set provider to "umami" in config for Umami)
ANALYTICS_BASE_URL=
ANALYTICS_SITE_ID=
ANALYTICS_TOKEN=
# Per-source config (set in the Sources UI, no env): GitHub Profile {"githubLogin"}, Google Alerts {"feeds":[...]},
# Newsletter RSS {"feedUrl"}, GDELT {"queries":[...]}; arXiv/NSF/GDELT need no keys.
