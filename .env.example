DATABASE_URL="file:./eb1a.db"
# Optional: PatentsView connector (https://patentsview.org/apis) and Semantic Scholar rate limits
PATENTSVIEW_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Optional: GitHub token (higher rate limits; enables contribution counts in GitHub Profile)
GITHUB_TOKEN=
# Optional: self-hosted Plausible/Umami (or set baseUrl/siteId/token in the "Site Analytics" Source config;
# set provider to "umami" in config for Umami)
ANALYTICS_BASE_URL=
ANALYTICS_SITE_ID=
ANALYTICS_TOKEN=
# Per-source config (set in the Sources UI, no env): GitHub Profile {"githubLogin"}, Google Alerts {"feeds":[...]},
# Newsletter RSS {"feedUrl"}, GDELT {"queries":[...]}; arXiv/NSF/GDELT need no keys.
